{
  "name": "@benh-vien-so/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "check": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "dev": "pnpm --filter @benh-vien-so/domain run build && pnpm --filter @benh-vien-so/contracts run build && tsx src/main.ts",
    "test": "vitest run src"
  },
  "dependencies": {
    "@benh-vien-so/contracts": "workspace:*",
    "@benh-vien-so/domain": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.11.2",
    "nanoid": "^6.0.1",
    "pg": "^8.22.0",
    "redis": "^6.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.4",
    "tsx": "^4.23.9"
  }
}
